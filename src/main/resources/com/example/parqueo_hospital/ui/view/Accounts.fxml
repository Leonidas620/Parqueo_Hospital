<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.parqueo_hospital.ui.controller.AccountsController">
    <padding>
        <Insets bottom="14.0" left="14.0" right="14.0" top="10.0" />
    </padding>
    <center>
        <TableView fx:id="table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colName" text="Nombre del Parqueador" />
                <TableColumn fx:id="colUser" text="Nombre de Usuario" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <padding>
                <Insets top="12.0" />
            </padding>
            <Button onAction="#createAccount" text="Crear Cuenta" />
            <Button onAction="#deleteAccount" text="Eliminar Cuenta" />
        </HBox>
    </bottom>
</BorderPane>
