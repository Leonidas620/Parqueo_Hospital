<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefWidth="380.0" spacing="14.0" styleClass="form-root" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.parqueo_hospital.ui.controller.DeleteSubscriptionDialogController">
    <padding>
        <Insets bottom="24.0" left="40.0" right="40.0" top="24.0" />
    </padding>
    <Label styleClass="form-title" text="Eliminar Abono" />
    <VBox spacing="4.0">
        <Label styleClass="field-label" text="Código del abono" />
        <TextField fx:id="txtCode" promptText="Ej. 12" />
    </VBox>
    <HBox alignment="CENTER" spacing="14.0">
        <VBox.margin>
            <Insets top="8.0" />
        </VBox.margin>
        <Button defaultButton="true" onAction="#confirm" text="Eliminar" />
        <Button cancelButton="true" onAction="#cancel" text="Cancelar" />
    </HBox>
</VBox>
