<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefWidth="400.0" spacing="12.0" styleClass="form-root" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.parqueo_hospital.ui.controller.SubscriptionDialogController">
    <padding>
        <Insets bottom="24.0" left="40.0" right="40.0" top="24.0" />
    </padding>
    <Label styleClass="form-title" text="Agregar Abono" />
    <VBox spacing="4.0">
        <Label styleClass="field-label" text="Chapa del vehículo" />
        <TextField fx:id="txtPlate" promptText="Ej. P123456" />
    </VBox>
    <VBox spacing="4.0">
        <Label styleClass="field-label" text="Mes" />
        <ComboBox fx:id="cmbMonth" maxWidth="Infinity" />
    </VBox>
    <VBox spacing="4.0">
        <Label styleClass="field-label" text="Año" />
        <Spinner fx:id="spnYear" editable="true" maxWidth="Infinity" />
    </VBox>
    <VBox spacing="4.0">
        <Label styleClass="field-label" text="Importe pagado" />
        <TextField fx:id="txtAmount" promptText="Ej. 500" />
    </VBox>
    <HBox alignment="CENTER" spacing="14.0">
        <VBox.margin>
            <Insets top="8.0" />
        </VBox.margin>
        <Button defaultButton="true" onAction="#confirm" text="Aceptar" />
        <Button cancelButton="true" onAction="#cancel" text="Cancelar" />
    </HBox>
</VBox>
