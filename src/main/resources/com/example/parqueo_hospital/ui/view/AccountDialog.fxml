<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefWidth="400.0" spacing="12.0" styleClass="form-root" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.parqueo_hospital.ui.controller.AccountDialogController">
    <padding>
        <Insets bottom="24.0" left="40.0" right="40.0" top="24.0" />
    </padding>
    <Label styleClass="form-title" text="Crear Cuenta" />
    <VBox spacing="4.0">
        <Label styleClass="field-label" text="Nombre del parqueador" />
        <TextField fx:id="txtName" />
    </VBox>
    <VBox spacing="4.0">
        <Label styleClass="field-label" text="Nombre de usuario" />
        <TextField fx:id="txtUser" />
    </VBox>
    <VBox spacing="4.0">
        <Label styleClass="field-label" text="Tipo de cuenta" />
        <ComboBox fx:id="cmbRole" maxWidth="Infinity" />
    </VBox>
    <Label styleClass="login-subtitle" text="La contraseña inicial es 1234; cada usuario puede cambiarla desde Mi cuenta." wrapText="true" />
    <HBox alignment="CENTER" spacing="14.0">
        <VBox.margin>
            <Insets top="8.0" />
        </VBox.margin>
        <Button defaultButton="true" onAction="#confirm" text="Crear" />
        <Button cancelButton="true" onAction="#cancel" text="Cancelar" />
    </HBox>
</VBox>
