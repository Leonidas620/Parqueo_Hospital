<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.parqueo_hospital.ui.controller.ServicesController">
    <padding>
        <Insets bottom="14.0" left="14.0" right="14.0" top="4.0" />
    </padding>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <padding>
                <Insets bottom="10.0" />
            </padding>
            <Label styleClass="search-label" text="Buscar por:" />
            <TextField fx:id="txtPlate" prefWidth="160.0" promptText="Chapa" />
            <TextField fx:id="txtParker" prefWidth="200.0" promptText="Parqueador" />
        </HBox>
    </top>
    <center>
        <TableView fx:id="table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colId" text="No." />
                <TableColumn fx:id="colPlate" text="Chapa" />
                <TableColumn fx:id="colEntryDate" text="Fecha Entrada" />
                <TableColumn fx:id="colEntryTime" text="Hora Entrada" />
                <TableColumn fx:id="colExitDate" text="Fecha Salida" />
                <TableColumn fx:id="colExitTime" text="Hora Salida" />
                <TableColumn fx:id="colRate" styleClass="right-aligned" text="Tarifa/h" />
                <TableColumn fx:id="colAmount" styleClass="right-aligned" text="Importe" />
                <TableColumn fx:id="colParker" text="Parqueador" />
            </columns>
        </TableView>
    </center>
</BorderPane>
