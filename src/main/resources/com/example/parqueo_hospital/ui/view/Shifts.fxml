<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.parqueo_hospital.ui.controller.ShiftsController">
    <padding>
        <Insets bottom="14.0" left="14.0" right="14.0" top="4.0" />
    </padding>
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="8.0">
            <padding>
                <Insets bottom="10.0" />
            </padding>
            <Label styleClass="search-label" text="Buscar por:" />
            <DatePicker fx:id="dateFilter" prefWidth="150.0" promptText="Fecha" />
            <TextField fx:id="txtParker" prefWidth="200.0" promptText="Parqueador" />
            <Button onAction="#search" styleClass="icon-button">
                <graphic>
                    <SVGPath content="M9 2a7 7 0 1 0 4.2 12.6l4.6 4.6 1.4-1.4-4.6-4.6A7 7 0 0 0 9 2zm0 2a5 5 0 1 1 0 10A5 5 0 0 1 9 4z" scaleX="0.8" scaleY="0.8" styleClass="icon-svg" />
                </graphic>
                <tooltip>
                    <Tooltip text="Actualizar la lista de turnos" />
                </tooltip>
            </Button>
        </HBox>
    </top>
    <center>
        <TableView fx:id="table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colId" prefWidth="63.20000779628754" text="No." />
                <TableColumn fx:id="colDate" prefWidth="84.00000762939453" text="Fecha" />
                <TableColumn fx:id="colParker" prefWidth="83.99993896484375" text="Parqueador" />
                <TableColumn fx:id="colStart" prefWidth="82.40010070800781" text="Hora Inicio" />
                <TableColumn fx:id="colEnd" prefWidth="65.5999755859375" text="Hora Fin" />
                <TableColumn fx:id="colTotal" prefWidth="102.39996337890625" styleClass="right-aligned" text="Total Recaudado" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <padding>
                <Insets top="12.0" />
            </padding>
            <Button fx:id="btnCloseDay" onAction="#closeDay" text="Cuadrar Día" />
        </HBox>
    </bottom>
</BorderPane>
